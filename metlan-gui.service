[Unit]
Description=MetLAN dashboard (FastAPI)
After=network.target

[Service]
Type=simple
User=metlan
WorkingDirectory=/home/metlan/metlan-gui
ExecStart=/home/metlan/metlan-gui/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
