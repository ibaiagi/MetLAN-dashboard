[Unit]
Description=MetLAN dashboard (FastAPI)
After=network.target

[Service]
Type=simple
User=metlan
WorkingDirectory=/home/metlan/MetLAN-dashboard
EnvironmentFile=-/home/metlan/MetLAN-dashboard/.env
ExecStart=/home/metlan/MetLAN-dashboard/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
